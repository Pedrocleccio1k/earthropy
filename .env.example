# Copy to .env (install.sh does it for you)

# GitHub user that publishes the EARTHROPY images (lowercase)
EARTHROPY_GITHUB_USER=pedrocleccio1k

# Port where the whole suite opens: http://SERVER-IP:9090
EARTHROPY_PORT=9090

# Folder with your files (shown by A Drive). On CasaOS servers it is usually /DATA
EARTHROPY_FILES=/DATA

# Time zone
TZ=America/Sao_Paulo

# Secret used by the dashboard to encrypt integration passwords (install.sh generates it)
SECRET_ENCRYPTION_KEY=
